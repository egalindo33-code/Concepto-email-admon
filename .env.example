# Copia este archivo a ".env" y llena los valores reales. NUNCA subas el
# archivo ".env" real a un repositorio público — contiene claves secretas.

# Clave de API de Anthropic (console.anthropic.com -> API Keys).
# Se cobra por uso (ver README.md para estimado de costo mensual).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelo a usar. claude-haiku-4-5-20251001 es el más económico y suficiente para
# clasificación + redacción de correos. Cambialo a un modelo más grande
# (ej. claude-sonnet-4-5) si quieres respuestas más matizadas, a mayor costo.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Notificación de urgencias (opcional) ---
# Canal: "email" o "ninguno". La alerta se manda con la misma conexión de
# Gmail (API) que ya usa el bot para leer/responder — no hace falta SMTP ni
# contraseña de aplicación. El destinatario se configura en
# config/directrices.yaml (notificacion_urgente.destinatario).
NOTIFY_CHANNEL=email

# --- Solo para despliegue headless (ej. Render) ---
# Si vas a correr esto en un servidor sin pantalla, NO uses
# credentials/client_secret.json ni credentials/token.json (requieren
# navegador). En vez de eso, corre UNA VEZ en tu propia computadora:
#   python scripts/generar_credenciales_render.py
# y copia los tres valores que te imprime aquí (o directo en el panel de
# variables de entorno del servicio, nunca en este archivo si vas a subirlo
# a un repositorio):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Panel web (opcional) ---
# Si quieres ver un resumen de la actividad del bot sin entrar a Gmail ni a
# Render, configura REDIS_URL (la misma en el bot y en el servicio del
# panel — ver dashboard/app.py). Sin esto, el bot funciona exactamente igual,
# solo sin panel.
REDIS_URL=
